# syntax=docker/dockerfile:1
#
# Multi-stage build for buddy-api. The builder stage compiles a static,
# CGO-free binary; the final stage ships only that binary on a distroless
# base with no shell, no package manager, and no OS userland at all.
#
# Build args:
#   VERSION -- injected into main.version via -ldflags -X (see cmd/buddy-api/main.go)
#   COMMIT  -- injected into main.commit via -ldflags -X
# Both default to "dev"/"unknown" to match the Go source defaults if the
# caller (normally `make docker-build`) omits them.

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------
# --platform=$BUILDPLATFORM pins this stage to the architecture of the
# machine running the build, never the target's. Combined with
# GOOS/GOARCH=$TARGETOS/$TARGETARCH on the go build below, that turns a
# multi-arch build into cross-compilation, which is what the Go toolchain is
# designed for. Without it, buildx would pull an arm64 golang image for the
# linux/arm64 leg and run the entire compile through QEMU user-mode
# emulation -- correct, but minutes slower, and dependent on binfmt handlers
# being registered on the host (GitHub-hosted runners register none by
# default, so the leg dies outright with "exec format error").
#
# BUILDPLATFORM/TARGETOS/TARGETARCH are supplied automatically by BuildKit.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

WORKDIR /src

# Copy only the dependency manifests first so `go mod download` is cached
# across builds and only re-runs when go.mod/go.sum actually change --
# editing application source must not invalidate this layer.
COPY go.mod go.sum ./
RUN go mod download

# Now bring in the rest of the source and build.
COPY cmd/ ./cmd/
COPY internal/ ./internal/

ARG VERSION=dev
ARG COMMIT=unknown

# TARGETOS/TARGETARCH come from BuildKit and name the image being produced,
# not the machine producing it. CGO_ENABLED=0 is what makes cross-compiling
# free here: with no C toolchain in play, the Go compiler emits a fully
# static binary for any GOOS/GOARCH pair without needing a cross-linker.
ARG TARGETOS
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" \
    -o /out/buddy-api \
    ./cmd/buddy-api

# ---------------------------------------------------------------------------
# Final
# ---------------------------------------------------------------------------
# distroless/static-debian12:nonroot ships no shell, no package manager, and
# no libc -- just CA certs, tzdata, and a passwd entry for uid/gid 65532.
# That absence is deliberate: `docker run --entrypoint sh` against this image
# fails, which is the point, and it is also why the Deployment cannot use an
# exec-based preStop hook -- there is no shell here to exec into. See
# docs/adr/0005 for the base-image choice and docs/adr/0002 for the
# in-process shutdown delay that replaces the preStop hook.
#
# This stage contains no RUN instruction, only a COPY of an
# already-cross-compiled binary, so nothing built for the target
# architecture ever executes during the build. That is what makes emulation
# unnecessary for the multi-arch build in CI.
FROM gcr.io/distroless/static-debian12:nonroot

ARG VERSION=dev
ARG COMMIT=unknown

LABEL org.opencontainers.image.source="https://github.com/kramersean/k8s-buddy" \
      org.opencontainers.image.title="buddy-api" \
      org.opencontainers.image.description="K8s Buddy's HTTP service -- the component Kubernetes probes, chaos experiments target, and Prometheus scrapes." \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.version="${VERSION}"

COPY --from=builder /out/buddy-api /buddy-api

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/buddy-api"]
